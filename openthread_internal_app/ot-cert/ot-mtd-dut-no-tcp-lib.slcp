project_name: ot-mtd-dut-no-tcp-lib
label: OpenThread - SoC MTD DUT (using certification libs without TCP)
package: openthread
description: >
  This is the ot-cli-mtd app without TCP functions built using the MTD certification config and linked against the certification library. It can operate in a Minimal Thread device (MTD) role including Synchronized Sleepy End Device (SSED) and can be used as the Device Under Test (DUT) in the Thread test harness.
category: OpenThread Certification Application|Internal
quality: internal

component:
  - id: sl_main
  - id: ot_stack_mtd
  - id: ot_stack_tcp_stubs
  - id: ot_cli_source
  - id: ot_crash_handler
  - id: iostream_recommended_console
  - id: rail_util_pti
  - id: ot_cert_libs
  - id: clock_manager
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc by installing the following component
  - id: toolchain_gcc_lto

include:
  - path: ../ot-cli
    file_list:
      - path: app.h

source:
  - path: ../ot-cli/app.c

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
    value: 1
  # This stack size is dependent on LTO optimization. In the cases, where LTO merges more than 1 functions in a single one
  # (includes inlining) causing the stack to increase. This project wide configuration, it is recommended to ensure this
  # configuration is updated with appropriate values based on the additional components installed and application code added.
  - name: SL_STACK_SIZE
    value: 6144
    condition: [toolchain_lto]
    unless: [freertos]
  - name: SL_STACK_SIZE
    value: 4608
    condition: [freertos]
    unless: [toolchain_lto]
  - name: SL_STACK_SIZE
    value: 5120
    condition: [toolchain_lto, freertos]
  - name: SL_STACK_SIZE
    value: 5120
    unless: [toolchain_lto, freertos]
  # Stack size config end
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 4608
    condition: [sl_main, freertos]
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 5120
    condition: [sl_main]
    unless: [freertos]
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition: [iostream_usart]
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    condition: [iostream_eusart]
  - name: OPENTHREAD_CONFIG_TCP_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_DNS_CLIENT_OVER_TCP_ENABLE
    value: 0
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 7168
    condition: [toolchain_lto]
  - name: configTOTAL_HEAP_SIZE
    value: 16384
    condition: [toolchain_lto, freertos]

tag:
  - hwfilter:device:device_supports_thread
  - hwfilter:!device:device_family_efr32mr21
  - toolchain:gcc
readme:
  - path: ../ot-cli/README.md

filter:
  - name: "Wireless Technology"
    value: ["Thread"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

ui_hints:
  highlight:
    - path: ../ot-cli/README.md
      focus: true
