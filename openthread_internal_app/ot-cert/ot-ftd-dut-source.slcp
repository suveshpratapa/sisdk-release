project_name: ot-ftd-dut-source
label: OpenThread - SoC FTD DUT (built from source)
package: openthread
description: >
  This is the ot-cli-ftd app built from source using the FTD certification config. It can operate in either a Full or Minimal Thread device (FTD or MTD) role including Synchronized Sleepy End Device (SSED) and can be used as the Device Under Test (DUT) in the Thread test harness. It also enables multi-instance support.
category: OpenThread Certification Application|Internal
quality: internal

component:
  - id: sl_main
  - id: ot_stack_ftd
  - id: ot_cli_source
  - id: ot_crash_handler
  - id: iostream_recommended_console
  - id: rail_util_pti
  - id: clock_manager
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc by installing the following component
  - id: toolchain_gcc_lto

config_file:
  - path: "../../config/sl_openthread_features_ftd_cert_config.h"
    override:
      file_id: openthread_features
      component: ot_stack_ftd

include:
  - path: ../ot-cli
    file_list:
      - path: app.h

source:
  - path: ../ot-cli/app.c

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
    value: 1
  # This stack size is dependent on LTO optimization. In the cases, where LTO merges more than 1 functions in a single one
  # (includes inlining) causing the stack to increase. This project wide configuration, it is recommended to ensure this
  # configuration is updated with appropriate values based on the additional components installed and application code added.
  - name: SL_STACK_SIZE
    value: 6144
    condition: [toolchain_lto]
    unless: [freertos]
  - name: SL_STACK_SIZE
    value: 4608
    condition: [freertos]
    unless: [toolchain_lto]
  - name: SL_STACK_SIZE
    value: 5120
    condition: [toolchain_lto, freertos]
  - name: SL_STACK_SIZE
    value: 5120
    unless: [toolchain_lto, freertos]
  # Stack size config end
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 4608
    condition: [sl_main, freertos]
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 5120
    condition: [sl_main]
    unless: [freertos]
# OpenThread allows a device built with FTD support to be dynamically
# configured as an MTD/SED at runtime (see the OT CLI mode command). 
# To allow it to also run as a SSED we must also enable CSL_RECEIVER.
  - name: OPENTHREAD_CONFIG_MAC_CSL_RECEIVER_ENABLE
    value: 1
# Build from source with COMMISSIONER and JOINER enabled even though
# the cert libraries do not have these features enabled.
  - name: OPENTHREAD_CONFIG_COMMISSIONER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_JOINER_ENABLE
    value: 1
# Build from source with the COAP APIs enabled so that we can
# self-certify the coap enabled cert libraries.
  - name: OPENTHREAD_CONFIG_COAP_API_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_COAP_OBSERVE_API_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_COAP_SECURE_API_ENABLE
    value: 1
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition: [iostream_usart]
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    condition: [iostream_eusart]
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 7168
    condition: [toolchain_lto]
  - name: configTOTAL_HEAP_SIZE
    value: 16384
    condition: [toolchain_lto, freertos]
  - name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MULTIPLE_STATIC_INSTANCE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_NUM
    value: 2

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_thread
  - hwfilter:!device:device_family_efr32mr21
  - toolchain:gcc
readme:
  - path: ../ot-cli/README.md

filter:
  - name: "Wireless Technology"
    value: ["Thread"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

ui_hints:
  highlight:
    - path: ../ot-cli/README.md
      focus: true
